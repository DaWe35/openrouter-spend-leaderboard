# Copy to .env and adjust. docker compose reads .env automatically.

# Host port for the web page (http://localhost:$PORT)
PORT=8080

# Optional: user/group the fetcher writes data/ and public/ as. Defaults to 1000:1000,
# the usual first user on Linux. Only change if `id -u` / `id -g` print something else.
# FETCH_UID=1000
# FETCH_GID=1000
